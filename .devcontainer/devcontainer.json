{
  "name": "Dyzulk Monorepo Dev Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/dyzulk",
  "remoteUser": "node",
  "forwardPorts": [3000, 3001],
  "portsAttributes": {
    "3000": {
      "label": "Web App (Next.js) → host:30000",
      "onAutoForward": "notify"
    },
    "3001": {
      "label": "Docs (Fumadocs) → host:30001",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "vercel.turbo-vscode",
        "unifiedjs.vscode-mdx",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "pkief.material-icon-theme"
      ]
    }
  },
  "postCreateCommand": "/bin/bash ./.devcontainer/post-create.sh",
  "postStartCommand": "pnpm build && pnpm start"
}
