{
  "name": "Dyzulk Monorepo Dev Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/dyzulk",
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "vercel.turbo-vscode",
        "unifiedjs.vscode-mdx",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "pkief.material-icon-theme"
      ]
    }
  },
  "postCreateCommand": "/bin/bash ./.devcontainer/post-create.sh",
  "postStartCommand": "pnpm build && pnpm start"
}
