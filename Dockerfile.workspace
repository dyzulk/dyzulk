# Meta: Multi-stage workspace Dockerfile for centralized monorepo deployments.
# Using Node 24 LTS and pnpm 11, supporting 'web', 'dashboard', and 'docs' apps.

# ── Stage 1: Base ─────────────────────────────────────────────
FROM node:24-alpine AS base
RUN npm install -g pnpm@9.15.9
WORKDIR /app

# ── Stage 2: Install dependencies ─────────────────────────────
FROM base AS installer
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/dashboard/package.json ./apps/dashboard/
COPY apps/docs/package.json ./apps/docs/
COPY packages/ui/package.json ./packages/ui/
COPY packages/server/package.json ./packages/server/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config/package.json ./packages/typescript-config/
RUN pnpm install --frozen-lockfile

# Copy all source files
COPY . .

# ── Stage 3: Build Web App (apps/web) ──────────────────────────
FROM installer AS web-builder
RUN pnpm build:web

FROM node:24-alpine AS web
RUN npm install -g pnpm@9.15.9
WORKDIR /app
COPY --from=web-builder /app ./
ENV PORT=3000
ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "start:web"]

# ── Stage 4: Build Dashboard App (apps/dashboard) ─────────────
FROM installer AS dashboard-builder
RUN pnpm build:dashboard

FROM node:24-alpine AS dashboard
RUN npm install -g pnpm@9.15.9
WORKDIR /app
COPY --from=dashboard-builder /app ./
ENV PORT=3000
ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "start:dashboard"]

# ── Stage 5: Build Docs App (apps/docs) ───────────────────────
FROM installer AS docs-builder
RUN pnpm build:docs

FROM node:24-alpine AS docs
RUN npm install -g pnpm@9.15.9
WORKDIR /app
COPY --from=docs-builder /app ./
ENV PORT=3000
ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "start:docs"]
